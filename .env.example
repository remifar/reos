# ---------- rEos Environment ----------
REOS_ENV=production
REOS_DOMAIN=localhost
REOS_LOG_LEVEL=info

# ---------- Security ----------
JWT_SECRET=change-me
JWT_EXPIRY=3600
ENCRYPTION_KEY=change-me

# ---------- PostgreSQL ----------
DB_HOST=db
DB_PORT=5432
DB_NAME=reos
DB_USER=reos
DB_PASSWORD=change-me

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ---------- NATS ----------
NATS_HOST=nats
NATS_PORT=4222
NATS_USER=reos
NATS_PASSWORD=change-me

# ---------- Object Storage ----------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=reos
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# ---------- Plugins ----------
PLUGIN_SIGNATURE_REQUIRED=true
PLUGIN_DIR=/var/lib/reos/plugins

# ---------- Bootstrap ----------
REOS_ADMIN_EMAIL=admin@localhost
REOS_TENANT_NAME="Default Tenant"
